node_modules/

# Dépendances copiées au build (npm run build:web), jamais versionnées.
apps/web/vendor/

# Ce que la console emporte depuis apps/web au build (npm run build:console).
# Versionné, il serait la copie qui reste vraie un temps, puis diverge.
apps/console/partage/
# La feuille de sprites, copiée à la racine de la console : `svgIcon` la résout
# contre la page.
apps/console/assets/

# Les lecteurs de mails descendus au serveur (npm run prepare:versement).
# Même raison que les autres copies : versionnée, celle-ci resterait vraie un
# temps, puis divergerait de celle qu'on éprouve.
supabase/functions/_shared/versement/
