{
  "name": "mdall",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run prepare:utilitaires && npm run prepare:versement",
    "test": "node --test $(find apps/web/js supabase/functions scripts -name '*.test.mjs' -print)",
    "test:spikes": "node --test $(find spikes -name '*.test.mjs' -print)",
    "prepare:katex": "node scripts/prepare-katex.mjs",
    "prepare:unpdf": "node scripts/prepare-unpdf.mjs",
    "prepare:spike-engine": "node scripts/prepare-spike-engine.mjs",
    "prepare:utilitaires": "node scripts/prepare-utilitaires.mjs",
    "prepare:console": "node scripts/prepare-console.mjs",
    "prepare:versement": "node scripts/prepare-versement.mjs",
    "build": "npm run build:web && npm run build:console",
    "build:web": "npm run prepare:katex && npm run prepare:unpdf && npm run prepare:spike-engine && npm run prepare:utilitaires",
    "build:fonctions": "npm run prepare:versement",
    "build:console": "npm run prepare:console"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "katex": "^0.16.9",
    "unpdf": "^1.8.1"
  }
}
