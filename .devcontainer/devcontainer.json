{
  "name": "Mdall",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem" }
  },
  "postCreateCommand": "npm install && npm --prefix services/opendataloader install",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Restitution (OpenDataLoader)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
